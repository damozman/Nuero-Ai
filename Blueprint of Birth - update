4. The Real-Time Smart File-Watcher Daemon

This background worker monitors your code repositories and directories. It checks file roots or path parameters to automatically assign the correct metadata tag owner upon saving a file.
python
# daemons/watcher.py
import os
import time
import json
from watchdog.observers import Observer
from watchdog.events import FileSystemEventHandler
from core.vector_engine import VectorMemoryVault

class NeuralFileHandler(FileSystemEventHandler):
    def __init__(self):
        self.vault = VectorMemoryVault()
        self.watch_config = self._load_rules()

    def _load_rules(self):
        path = "config/watch_folders.json"
        if os.path.exists(path):
            with open(path, "r") as f:
                return json.load(f)
        return {}

    def on_modified(self, event):
        if not event.is_directory and event.src_path.endswith(('.txt', '.md', '.log', '.py')):
            time.sleep(0.5) # Allow file buffers to clear
            
            # Determine appropriate bot association based on file layout paths
            assigned_bot = "shared"
            normalized_path = event.src_path.replace("\\", "/")
            
            for folder, bot_id in self.watch_config.items():
                if folder in normalized_path:
                    assigned_bot = bot_id
                    break

            try:
                with open(event.src_path, "r", encoding="utf-8", errors="ignore") as f:
                    content = f.read()
                if content.strip():
                    self.vault.add_memory(content, bot_id=assigned_bot, metadata={"source": event.src_path})
                    print(f"\n[DAEMON]: Ingested memory block into partition [{assigned_bot}] from {os.path.basename(event.src_path)}")
            except Exception as e:
                pass # Fail silently in background thread loops

def start_memory_daemon():
    # Reads targeted folders configuration file mapping directories to your bots
    event_handler = NeuralFileHandler()
    observer = Observer()
    observer.schedule(event_handler, path="./storage/vault", recursive=True)
    observer.start()
    print("[DAEMON]: File-system watcher tracking storage targets...")
    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        observer.stop()
    observer.join()
