2. The Identity-Isolated Privacy Filter

This module has been stripped of all outside agency indicators. It uses strict local regex array matches to mask identities before web transport and provides a clean local replacement fallback.
python
# core/scrubber.py
import re
import json
import os

class MemoryScrubber:
    def __init__(self, rules_path="config/masking_rules.json"):
        self.rules_path = rules_path
        self.mask_rules = {
            r"\b\d{3}\s+S\.\s+Hulen\s+St\b.*?76133\b": "[LOCAL_HQ_ADDRESS]",
            r"\bChristopher\s+Wade\s+Mosley\b": "[FOUNDER_IDENTITY]"
        }
        self.reverse_rules = {v: k for k, v in self.mask_rules.items()}
        self._load_rules()

    def _load_rules(self):
        if os.path.exists(self.rules_path):
            with open(self.rules_path, "r") as f:
                loaded = json.load(f)
                self.mask_rules.update(loaded)
                self.reverse_rules = {v: k for k, v in self.mask_rules.items()}

    def mask(self, text: str) -> str:
        masked_text = text
        for pattern, replacement in self.mask_rules.items():
            masked_text = re.sub(pattern, replacement, masked_text, flags=re.IGNORECASE)
        return masked_text

    def unmask(self, text: str) -> str:
        unmasked_text = text
        for token, original in self.reverse_rules.items():
            clean_original = original.replace(r"\b", "").replace(r".*?", " ")
            unmasked_text = unmasked_text.replace(token, "[REHYDRATED_DATA]")
        return unmasked_text
