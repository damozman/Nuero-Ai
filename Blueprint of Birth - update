# core/pipeline.py
import os
import json
import asyncio
from google import genai
from core.scrubber import MemoryScrubber
from core.vector_engine import VectorMemoryVault

class NueroPipeline:
    def __init__(self):
        self.scrubber = MemoryScrubber()
        self.vault = VectorMemoryVault()
        self.client = genai.Client(api_key=os.environ.get("GEMINI_API_KEY"))
        
    def _get_bot_config(self, bot_id: str) -> dict:
        path = f"config/bots/{bot_id}.json"
        if os.path.exists(path):
            with open(path, "r") as f:
                return json.load(f)
        return {"name": "NueroCore", "identity_frequency": "You are a private, local neural node."}

    async def chat_with_node(self, bot_id: str, user_input: str, is_council: bool = False) -> dict:
        """Executes a private context-isolated conversation loop for a specific bot."""
        bot_config = self._get_bot_config(bot_id)
        
        # Determine RAG partition scope: isolate if single chat, expand if in council
        search_scope = None if is_council else bot_id
        raw_context = self.vault.query_memories(user_input, bot_id=search_scope, limit=3)
        
        # Execute zero-latency local obfuscation
        masked_context = self.scrubber.mask(raw_context)
        masked_prompt = self.scrubber.mask(user_input)
        identity_frequency = self.scrubber.mask(bot_config["identity_frequency"])

        system_instruction = f"""
        {identity_frequency}

        [LOCAL MEMORY CONTEXT MATRIX]:
        {masked_context}
        """

        # Non-blocking async dispatch to the cloud developer cluster
        response = await self.client.aio.models.generate_content(
            model='gemini-2.5-flash',
            contents=masked_prompt,
            config={"system_instruction": system_instruction}
        )

        final_output = self.scrubber.unmask(response.text)
        return {"bot_name": bot_config["name"], "output": final_output}

    async def invoke_council(self, active_bot_ids: list, user_input: str) -> list:
        """Blasts all selected bot profiles simultaneously using asynchronous fan-out processing."""
        tasks = [self.chat_with_node(bot_id, user_input, is_council=True) for bot_id in active_bot_ids]
        council_results = await asyncio.gather(*tasks)
        return council_results
