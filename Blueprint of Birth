import os
import time
from watchdog.observers import Observer
from watchdog.events import FileSystemEventHandler
from core.vector_engine import VectorMemoryVault

class MemoryFileHandler(FileSystemEventHandler):
    def __init__(self):
        self.vault = VectorMemoryVault()

    def on_created(self, event):
        if not event.is_directory and event.src_path.endswith(('.txt', '.md', '.log')):
            time.sleep(1)
            with open(event.src_path, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
                self.vault.add_memory(content, metadata={"source": f"watcher:{event.src_path}"})
                print(f"\n[DAEMON]: Automatically ingested new neuron node from: {os.path.basename(event.src_path)}")

def start_memory_daemon():
    path = "storage/vault/"
    os.makedirs(path, exist_ok=True)
    observer = Observer()
    observer.schedule(MemoryFileHandler(), path=path, recursive=False)
    observer.start()
    print(f"[DAEMON]: Active. Monitoring local vault folder: '{path}'...")
    return observer
